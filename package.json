{
  "name": "@railson-is/ux-review",
  "version": "0.2.0",
  "private": true,
  "description": "Subagente do Claude Code que revisa UX e acessibilidade com prova medida (WCAG 2.2 e NN/g).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ux-review": "bin/ux-review.mjs"
  },
  "files": [
    "bin",
    "agents",
    "suporte",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/railson-is/ux-review.git"
  },
  "homepage": "https://github.com/railson-is/ux-review#readme",
  "bugs": {
    "url": "https://github.com/railson-is/ux-review/issues"
  },
  "keywords": [
    "claude-code",
    "subagent",
    "ux",
    "acessibilidade",
    "wcag",
    "axe-core",
    "playwright"
  ],
  "scripts": {
    "testar": "node --test \"testes/*.test.mjs\"",
    "banco:servir": "node banco-de-provas/banco.mjs servir",
    "banco:calibrar": "node banco-de-provas/banco.mjs calibrar",
    "banco:avaliar": "node banco-de-provas/banco.mjs avaliar",
    "banco:pedido": "node banco-de-provas/banco.mjs pedido",
    "pacote": "npm pack --dry-run"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.65.1"
  }
}
